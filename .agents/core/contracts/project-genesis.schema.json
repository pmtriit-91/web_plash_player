{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-os.local/schemas/project-genesis.schema.json",
  "title": "Universal Agent OS Project Genesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "document_id", "revision", "claims", "extensions", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "$ref": "#/$defs/safeId" },
    "document_id": { "$ref": "#/$defs/safeId" },
    "revision": { "type": "integer", "minimum": 1 },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "problem", "primary_user", "why_now", "input", "core_transformation", "output", "desired_outcome", "success", "acceptance_evidence", "failure_conditions", "scope", "non_goals", "invariants", "constraints", "assumptions", "unknowns"],
      "properties": {
        "identity": { "$ref": "#/$defs/claimHistory" },
        "problem": { "$ref": "#/$defs/claimHistory" },
        "primary_user": { "$ref": "#/$defs/claimHistory" },
        "why_now": { "$ref": "#/$defs/claimHistory" },
        "input": { "$ref": "#/$defs/claimHistory" },
        "core_transformation": { "$ref": "#/$defs/claimHistory" },
        "output": { "$ref": "#/$defs/claimHistory" },
        "desired_outcome": { "$ref": "#/$defs/claimHistory" },
        "success": { "$ref": "#/$defs/claimHistory" },
        "acceptance_evidence": { "$ref": "#/$defs/claimHistory" },
        "failure_conditions": { "$ref": "#/$defs/claimHistory" },
        "scope": { "$ref": "#/$defs/claimHistory" },
        "non_goals": { "$ref": "#/$defs/claimHistory" },
        "invariants": { "$ref": "#/$defs/claimHistory" },
        "constraints": { "$ref": "#/$defs/claimHistory" },
        "assumptions": { "$ref": "#/$defs/claimHistory" },
        "unknowns": { "$ref": "#/$defs/claimHistory" }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]{1,127}$" },
      "additionalProperties": { "$ref": "#/$defs/extension" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:)(?![/~\\\\])(?!\\.{1,2}(?:/|$))(?!.*(?:/\\.{1,2})(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "sha256", "git_commit"],
      "properties": {
        "kind": { "enum": ["repository-file", "binding", "decision-receipt", "confirmation-receipt", "research-artifact", "historical-record"] },
        "ref": { "$ref": "#/$defs/portablePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "git_commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "receipt_ref", "receipt_sha256", "basis_sha256"],
      "properties": {
        "event_id": { "$ref": "#/$defs/safeId" },
        "receipt_ref": { "$ref": "#/$defs/portablePath" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "basis_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "value", "authority", "confidence", "evidence", "supersedes", "created_at", "updated_at"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/safeId" },
        "value": {},
        "authority": { "enum": ["binding", "user-confirmed", "project-decision", "git-evidence", "research-only", "historical"] },
        "confidence": { "enum": ["confirmed", "verified", "inferred", "unknown"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "confirmation": { "$ref": "#/$defs/confirmation" },
        "supersedes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "claimHistory": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/claim" }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_ref", "owner", "required_for_confirmation", "value"],
      "properties": {
        "schema_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "owner": { "const": "application" },
        "required_for_confirmation": { "type": "boolean", "default": false },
        "value": {}
      }
    }
  }
}
