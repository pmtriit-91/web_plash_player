{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/continuity-restore-backup-index.schema.json",
  "title": "Universal Agent OS continuity restore backup index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backup_id",
    "plan_id",
    "project_id",
    "created_at",
    "files",
    "raw_conversation_stored",
    "prompt_stored",
    "chain_of_thought_stored",
    "secret_stored",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "backup_id": {"type": "string", "pattern": "^continuity-restore-backup-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "path",
          "present",
          "sha256",
          "bytes",
          "storage_path"
        ],
        "properties": {
          "entry_id": {"type": "string", "pattern": "^continuity-entry-[0-9a-f]{24}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "present": {"type": "boolean"},
          "sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              {"type": "null"}
            ]
          },
          "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
          "storage_path": {
            "type": ["string", "null"],
            "pattern": "^files/continuity-entry-[0-9a-f]{24}\\.bin$"
          }
        }
      }
    },
    "raw_conversation_stored": {"const": false},
    "prompt_stored": {"const": false},
    "chain_of_thought_stored": {"const": false},
    "secret_stored": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
