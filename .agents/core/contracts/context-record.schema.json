{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/context-record.schema.json",
  "title": "Universal Agent OS context record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "tier",
    "kind",
    "title",
    "summary",
    "status",
    "authority",
    "source_refs",
    "created_at",
    "updated_at",
    "supersedes",
    "tags"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,95}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tier": {"enum": ["hot", "warm", "cold"]},
    "kind": {
      "enum": [
        "identity",
        "current-state",
        "guardrail",
        "decision",
        "architecture",
        "convention",
        "known-issue",
        "research",
        "historical"
      ]
    },
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "summary": {"type": "string", "minLength": 3, "maxLength": 4000},
    "status": {"enum": ["active", "superseded", "archived"]},
    "authority": {
      "enum": [
        "binding",
        "git-evidence",
        "user-confirmed",
        "project-decision",
        "research-only",
        "historical"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "git_commit"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "supersedes": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,95}$"}
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    }
  }
}
