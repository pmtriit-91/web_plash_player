{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/context-manifest.schema.json",
  "title": "Universal Agent OS project context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "authority_order",
    "sources",
    "active_task_ledger",
    "active_task_ledger_sha256",
    "handoff_directory",
    "projection",
    "budgets",
    "refreshed_at",
    "refreshed_commit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_aliases"],
      "properties": {
        "remote_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "authority_order": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "binding",
          "git-evidence",
          "user-confirmed",
          "project-decision",
          "research-only",
          "historical"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "path",
          "owner",
          "format",
          "load_policy",
          "authority",
          "content_sha256",
          "canonical_keys"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,95}$"},
          "tier": {"enum": ["hot", "warm", "cold"]},
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "owner": {"const": "application"},
          "format": {"enum": ["context-store-json", "task-ledger-json", "handoff-json"]},
          "load_policy": {"enum": ["boot", "just-in-time", "explicit-only"]},
          "authority": {
            "enum": [
              "binding",
              "git-evidence",
              "user-confirmed",
              "project-decision",
              "research-only",
              "historical"
            ]
          },
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "canonical_keys": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "connector": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    },
    "active_task_ledger": {"type": "string", "minLength": 1, "maxLength": 512},
    "active_task_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoff_directory": {"type": "string", "minLength": 1, "maxLength": 512},
    "projection": {"type": "string", "minLength": 1, "maxLength": 512},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hot_max_bytes", "warm_max_bytes", "cold_max_records", "projection_max_bytes"],
      "properties": {
        "hot_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 262144},
        "warm_max_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "cold_max_records": {"type": "integer", "minimum": 1, "maximum": 100000},
        "projection_max_bytes": {"type": "integer", "minimum": 512, "maximum": 65536}
      }
    },
    "refreshed_at": {"type": "string", "format": "date-time"},
    "refreshed_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
  }
}
