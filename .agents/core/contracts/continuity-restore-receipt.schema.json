{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/continuity-restore-receipt.schema.json",
  "title": "Universal Agent OS continuity restore receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "plan_id",
    "operation",
    "status",
    "project_id",
    "base_commit",
    "applied_at",
    "binding_sha256",
    "adapter_fingerprint_sha256",
    "core_manifest_sha256",
    "record_type_registry_sha256",
    "recovery_profile_sha256",
    "retention_policy_sha256",
    "bundle",
    "targets",
    "target_inventory_sha256",
    "target_execution_order",
    "backup",
    "post_apply",
    "backup_verified",
    "rollback_ready",
    "source_deleted",
    "core_overwritten",
    "owner_confirmation_performed",
    "raw_conversation_stored",
    "prompt_stored",
    "chain_of_thought_stored",
    "secret_stored",
    "commit_created",
    "push_performed",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^continuity-restore-[0-9a-f]{24}$"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "operation": {"const": "restore"},
    "status": {"const": "applied"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "applied_at": {"type": "string", "format": "date-time"},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "core_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "record_type_registry_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_profile_sha256": {"$ref": "#/$defs/sha256"},
    "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
    "bundle": {"$ref": "#/$defs/bundle"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/target"}
    },
    "target_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_execution_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^continuity-entry-[0-9a-f]{24}$"}
    },
    "backup": {"$ref": "#/$defs/backup"},
    "post_apply": {"$ref": "#/$defs/postApply"},
    "backup_verified": {"const": true},
    "rollback_ready": {"const": true},
    "source_deleted": {"const": false},
    "core_overwritten": {"const": false},
    "owner_confirmation_performed": {"const": false},
    "raw_conversation_stored": {"const": false},
    "prompt_stored": {"const": false},
    "chain_of_thought_stored": {"const": false},
    "secret_stored": {"const": false},
    "commit_created": {"const": false},
    "push_performed": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "manifest_sha256", "inventory_sha256"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^continuity-export-[0-9a-f]{24}$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "path", "action", "before_sha256", "after_sha256", "bytes"],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^continuity-entry-[0-9a-f]{24}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "action": {"enum": ["create", "replace"]},
        "before_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_id", "index_path", "index_sha256"],
      "properties": {
        "backup_id": {"type": "string", "pattern": "^continuity-restore-backup-[0-9a-f]{24}$"},
        "index_path": {
          "type": "string",
          "pattern": "^\\.agents/project/context/continuity-restore-backups/continuity-restore-backup-[0-9a-f]{24}/index\\.json$"
        },
        "index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "postApply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_memory_state",
        "continuity_topology_state",
        "continuity_authority_state",
        "reason_codes"
      ],
      "properties": {
        "context_memory_state": {"const": "FRESH"},
        "continuity_topology_state": {"const": "complete"},
        "continuity_authority_state": {"enum": ["available", "partial"]},
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
