{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-os.local/schemas/project-genesis-confirmation-receipt.schema.json",
  "title": "Universal Agent OS Project Genesis confirmation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "project_id",
    "document_id",
    "issued_for_revision",
    "confirmed_by_role",
    "confirmed_at",
    "plan_sha256",
    "claim_bindings",
    "raw_conversation_stored",
    "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "$ref": "#/$defs/safeId" },
    "project_id": { "$ref": "#/$defs/safeId" },
    "document_id": { "$ref": "#/$defs/safeId" },
    "issued_for_revision": { "type": "integer", "minimum": 1 },
    "confirmed_by_role": { "const": "owner" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "claim_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "claim_id", "basis_sha256"],
        "properties": {
          "slot": { "$ref": "#/$defs/safeId" },
          "claim_id": { "$ref": "#/$defs/safeId" },
          "basis_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "raw_conversation_stored": { "const": false },
    "content_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
