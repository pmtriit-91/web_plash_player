{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.invalid/schemas/client-bridge-registry.schema.json",
  "title": "Agent OS Client Bridge Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary_client",
    "bridges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "primary_client": {
      "type": "string",
      "minLength": 1
    },
    "bridges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status",
          "root_file",
          "template",
          "discovery",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "reference-client",
              "thin-shim"
            ]
          },
          "root_file": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "discovery": {
            "enum": [
              "verified-by-fresh-session",
              "client-dependent",
              "evidence-required"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
