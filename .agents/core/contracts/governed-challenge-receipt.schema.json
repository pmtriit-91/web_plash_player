{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/governed-challenge-receipt.schema.json",
  "title": "Universal Agent OS governed challenge receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "project_id", "created_at", "request_sha256", "plan_sha256", "authority_sha256", "critic_relation", "findings", "counterexamples", "limitations", "recommended_disposition", "supersedes", "privacy", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^challenge-[0-9a-f]{24}$"},
    "project_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "request_sha256": {"$ref": "#/$defs/sha"},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "authority_sha256": {"$ref": "#/$defs/sha"},
    "critic_relation": {"enum": ["independent", "partially-correlated", "correlated", "unknown"]},
    "findings": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}},
    "counterexamples": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "limitations": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "recommended_disposition": {"enum": ["proceed", "escalate", "block"]},
    "supersedes": {"oneOf": [{"type": "string", "pattern": "^challenge-[0-9a-f]{24}$"}, {"type": "null"}]},
    "privacy": {"$ref": "#/$defs/privacy"},
    "content_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "category", "severity", "claim", "evidence_refs", "remediation"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "category": {"enum": ["mission-drift", "authority", "evidence", "safety", "privacy", "recovery", "completion", "cost", "operations"]}, "severity": {"enum": ["blocker", "material", "minor"]}, "claim": {"$ref": "#/$defs/text"}, "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "remediation": {"$ref": "#/$defs/text"}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["raw_conversation_stored", "raw_prompt_stored", "chain_of_thought_stored", "secret_stored"], "properties": {"raw_conversation_stored": {"const": false}, "raw_prompt_stored": {"const": false}, "chain_of_thought_stored": {"const": false}, "secret_stored": {"const": false}}}
  }
}
