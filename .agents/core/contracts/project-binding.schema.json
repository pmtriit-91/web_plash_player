{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-os.local/schemas/project-binding.schema.json",
  "title": "Universal Agent OS Project Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "repository",
    "commands",
    "created_at",
    "last_verified_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "root_markers"],
      "properties": {
        "kind": { "enum": ["git", "directory"] },
        "root_markers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "remote_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "root_markers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "root_markers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workspace", "runner", "script", "evidence", "risk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "workspace": { "type": "string", "minLength": 1 },
          "runner": {
            "enum": ["npm-script", "pnpm-script", "yarn-script", "bun-script", "make-target", "task-target"]
          },
          "script": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "risk": { "enum": ["read_only", "non_destructive", "destructive"] },
          "requires_confirmation": { "type": "boolean" }
        }
      }
    },
    "context_entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "last_verified_commit": { "type": ["string", "null"] }
  }
}
