{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/continuity-portability-plan.schema.json",
  "title": "Universal Agent OS archive or export plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "operation",
    "created_at",
    "expires_at",
    "git_head",
    "project_id",
    "binding_sha256",
    "adapter_fingerprint_sha256",
    "core_manifest_sha256",
    "record_type_registry_sha256",
    "recovery_profile_sha256",
    "retention_policy_sha256",
    "artifact_id",
    "artifact_manifest_sha256",
    "source_inventory_sha256",
    "destination",
    "metadata",
    "commit_created",
    "push_performed",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "status": {"enum": ["pending-approval", "applied", "failed", "expired"]},
    "operation": {"enum": ["archive", "export"]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "core_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "record_type_registry_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_profile_sha256": {"$ref": "#/$defs/sha256"},
    "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_id": {"type": "string", "pattern": "^continuity-(?:archive|export)-[0-9a-f]{24}$"},
    "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "destination": {"type": "string", "minLength": 1, "maxLength": 4096},
    "metadata": {
      "oneOf": [
        {"$ref": "#/$defs/archiveMetadata"},
        {"$ref": "#/$defs/exportMetadata"}
      ]
    },
    "commit_created": {"const": false},
    "push_performed": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "archive"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^continuity-archive-[0-9a-f]{24}$"},
          "destination": {"type": "string", "pattern": "^project/context/continuity-archives/continuity-archive-[0-9a-f]{24}$"},
          "metadata": {"$ref": "#/$defs/archiveMetadata"}
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "export"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^continuity-export-[0-9a-f]{24}$"},
          "metadata": {"$ref": "#/$defs/exportMetadata"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archiveMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_ids", "summary_sha256"],
      "properties": {
        "reference_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "summary_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "exportMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_kind"],
      "properties": {
        "bundle_kind": {"const": "offline-continuity"}
      }
    }
  }
}
