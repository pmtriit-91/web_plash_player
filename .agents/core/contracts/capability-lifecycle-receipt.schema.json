{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-os.local/schemas/capability-lifecycle-receipt.schema.json",
  "title": "Universal Agent OS Capability Lifecycle Receipt Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "append_only", "receipts"],
  "properties": {
    "schema_version": { "const": 1 },
    "append_only": { "const": true },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "id", "candidate_id", "capability_id", "action", "state", "integration_mode", "at", "decision_ref", "source_snapshot_sha256", "eval_case_ids", "manifest_refresh_required", "commit_created", "push_performed", "content_sha256"],
        "properties": {
          "schema_version": { "const": 1 },
          "id": { "type": "string", "pattern": "^lifecycle-[0-9a-f]{24}$" },
          "candidate_id": { "type": ["string", "null"] },
          "capability_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "action": { "enum": ["integrate", "update", "state-change", "rollback"] },
          "state": { "enum": ["active", "manual-only", "disabled", "quarantined", "deprecated"] },
          "integration_mode": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "decision_ref": { "type": ["string", "null"] },
          "source_snapshot_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "eval_case_ids": { "type": "array", "items": { "type": "string" } },
          "replacement": { "type": ["string", "null"] },
          "manifest_refresh_required": { "const": true },
          "commit_created": { "const": false },
          "push_performed": { "const": false },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
