{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/governed-reasoning-request.schema.json",
  "title": "Universal Agent OS governed reasoning request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "created_at", "goal", "objectives", "constraints", "assumptions", "options", "evidence", "authority", "privacy", "content_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^request-[0-9a-f]{24}$"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "goal": {"type": "string", "minLength": 3, "maxLength": 4096},
    "objectives": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/statement"}},
    "constraints": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/statement"}},
    "assumptions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/claim"}},
    "options": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/option"}},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/evidence_ref"}},
    "authority": {"$ref": "#/$defs/authority"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "status", "confidence", "evidence_refs"],
      "properties": {
        "claim": {"$ref": "#/$defs/statement"},
        "status": {"enum": ["verified", "inferred", "owner-input-required", "unknown"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "summary", "reversibility", "evidence_refs", "risks"],
      "properties": {
        "option_id": {"$ref": "#/$defs/identifier"},
        "summary": {"$ref": "#/$defs/statement"},
        "reversibility": {"enum": ["reversible", "partially-reversible", "irreversible", "unknown"]},
        "evidence_refs": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "risks": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/statement"}}
      }
    },
    "evidence_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "kind", "reference", "sha256", "git_commit"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["git-blob", "file", "test", "runtime", "receipt", "owner-intent", "policy"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"oneOf": [{"$ref": "#/$defs/git_commit"}, {"type": "null"}]}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_sha256", "genesis_revision", "genesis_source_sha256", "intent_sha256", "approval_sha256", "policy_sha256"],
      "properties": {
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "genesis_revision": {"type": "integer", "minimum": 1},
        "genesis_source_sha256": {"$ref": "#/$defs/sha256"},
        "intent_sha256": {"$ref": "#/$defs/sha256"},
        "approval_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["raw_conversation_stored", "raw_prompt_stored", "chain_of_thought_stored", "secret_stored"],
      "properties": {
        "raw_conversation_stored": {"const": false},
        "raw_prompt_stored": {"const": false},
        "chain_of_thought_stored": {"const": false},
        "secret_stored": {"const": false}
      }
    }
  }
}
