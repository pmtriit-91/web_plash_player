{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-agent-os.local/schemas/capability-routing-corpus.schema.json",
  "title": "Universal Agent OS Capability Lifecycle Routing Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability_id", "positive", "negative", "method", "status"],
        "properties": {
          "id": { "type": "string" },
          "capability_id": { "type": "string" },
          "positive": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "negative": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "method": { "const": "proposed-portfolio-shadow-v1" },
          "status": { "enum": ["passing", "failing", "retired"] }
        }
      }
    }
  }
}
