{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/schemas/continuity-restore-plan.schema.json",
  "title": "Universal Agent OS continuity restore plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "operation",
    "created_at",
    "expires_at",
    "git_head",
    "project_id",
    "binding_sha256",
    "adapter_fingerprint_sha256",
    "core_manifest_sha256",
    "record_type_registry_sha256",
    "recovery_profile_sha256",
    "retention_policy_sha256",
    "bundle",
    "targets",
    "target_inventory_sha256",
    "target_execution_order",
    "backup_id",
    "exact_diff",
    "commit_created",
    "push_performed",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "status": {"enum": ["pending-approval", "applied", "failed", "expired"]},
    "operation": {"const": "restore"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "adapter_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "core_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "record_type_registry_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_profile_sha256": {"$ref": "#/$defs/sha256"},
    "retention_policy_sha256": {"$ref": "#/$defs/sha256"},
    "bundle": {"$ref": "#/$defs/bundleReference"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/target"}
    },
    "target_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "target_execution_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^continuity-entry-[0-9a-f]{24}$"}
    },
    "backup_id": {"type": "string", "pattern": "^continuity-restore-backup-[0-9a-f]{24}$"},
    "exact_diff": {"type": "string", "maxLength": 1048576},
    "commit_created": {"const": false},
    "push_performed": {"const": false},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundleReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "staged_path", "manifest_sha256", "inventory_sha256"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^continuity-export-[0-9a-f]{24}$"},
        "staged_path": {
          "type": "string",
          "pattern": "^_runtime/continuity-portability/staging/continuity-export-[0-9a-f]{24}$"
        },
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "path",
        "action",
        "before_sha256",
        "after_sha256",
        "bytes",
        "backup_required"
      ],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^continuity-entry-[0-9a-f]{24}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "action": {"enum": ["create", "replace"]},
        "before_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "after_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "backup_required": {"const": true}
      }
    }
  }
}
